{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-script.local/schema/computation-index-1.0.0.json",
  "title": "Proof-Script Finalized Computation Index",
  "type": "object",
  "required": ["schemaVersion", "abi", "bundles", "pagesUpdated"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "abi": { "const": "proof-script-json-v1" },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bundleId", "bundleHash", "entries", "manifest", "module", "wasm"],
        "properties": {
          "bundleId": { "type": "string", "minLength": 1 },
          "bundleHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "entries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "manifest": { "type": "object" },
          "module": { "type": "object" },
          "wasm": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "pagesUpdated": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
