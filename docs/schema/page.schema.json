{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-script.local/schema/page-0.2.0.json",
  "title": "Proof-Script Page JSON",
  "type": "object",
  "required": ["schemaVersion", "ProjectInfo", "module", "source", "components"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "ProjectInfo": { "$ref": "#/$defs/projectInfo" },
    "module": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "nullableLabel": {
      "oneOf": [
        { "$ref": "#/$defs/label" },
        { "type": "null" }
      ]
    },
    "sourceLocation": {
      "type": "object",
      "required": ["file", "start", "stop"],
      "properties": {
        "file": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "stop": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "stringPair": {
      "type": "array",
      "prefixItems": [{ "type": "string" }, { "type": "string" }],
      "minItems": 2,
      "maxItems": 2
    },
    "projectInfo": {
      "type": "object",
      "required": ["title", "authors", "abstract", "keywords", "journal", "year", "url", "license", "arxivId", "doi", "note", "extra"],
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "abstract": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "journal": { "type": "string" },
        "year": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "arxivId": { "type": "string" },
        "doi": { "type": "string" },
        "note": { "type": "string" },
        "extra": { "type": "array", "items": { "$ref": "#/$defs/stringPair" } }
      },
      "additionalProperties": false
    },
    "theoremInfo": {
      "type": "object",
      "required": ["project", "name", "label", "tags", "extra"],
      "properties": {
        "project": { "$ref": "#/$defs/projectInfo" },
        "name": { "type": "string" },
        "label": { "$ref": "#/$defs/nullableLabel" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "extra": { "type": "array", "items": { "$ref": "#/$defs/stringPair" } }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["title", "label", "extra"],
      "properties": {
        "title": { "type": "string" },
        "label": { "$ref": "#/$defs/nullableLabel" },
        "extra": {
          "type": "array",
          "items": { "$ref": "#/$defs/stringPair" }
        }
      },
      "additionalProperties": false
    },
    "latexComponent": {
      "type": "object",
      "required": ["metadata", "language", "source", "svg"],
      "properties": {
        "metadata": { "$ref": "#/$defs/metadata" },
        "language": { "const": "latex" },
        "source": { "type": "string" },
        "svg": { "type": "string" }
      },
      "additionalProperties": false
    },
    "figureComponent": {
      "type": "object",
      "required": ["metadata", "path", "extension"],
      "properties": {
        "metadata": { "$ref": "#/$defs/metadata" },
        "path": { "type": "string", "minLength": 1 },
        "extension": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "referenceKind": {
      "enum": ["heading", "theorem", "figure"]
    },
    "inline": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "text": {
          "type": "object",
          "required": ["value"],
          "properties": { "value": { "type": "string" } },
          "additionalProperties": false
        },
        "strong": { "$ref": "#/$defs/inlineContainer" },
        "emphasis": { "$ref": "#/$defs/inlineContainer" },
        "strongEmphasis": { "$ref": "#/$defs/inlineContainer" },
        "strike": { "$ref": "#/$defs/inlineContainer" },
        "underline": { "$ref": "#/$defs/inlineContainer" },
        "highlight": { "$ref": "#/$defs/inlineContainer" },
        "superscript": { "$ref": "#/$defs/inlineContainer" },
        "subscript": { "$ref": "#/$defs/inlineContainer" },
        "code": {
          "type": "object",
          "required": ["value"],
          "properties": { "value": { "type": "string" } },
          "additionalProperties": false
        },
        "math": {
          "type": "object",
          "required": ["latex"],
          "properties": { "latex": { "type": "string" } },
          "additionalProperties": false
        },
        "link": {
          "type": "object",
          "required": ["content", "url"],
          "properties": {
            "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "reference": {
          "type": "object",
          "required": ["kind", "label"],
          "properties": {
            "kind": { "$ref": "#/$defs/referenceKind" },
            "label": { "$ref": "#/$defs/label" }
          },
          "additionalProperties": false
        },
        "softBreak": { "type": "object", "maxProperties": 0 },
        "hardBreak": { "type": "object", "maxProperties": 0 }
      },
      "additionalProperties": false
    },
    "inlineContainer": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "paragraph": { "$ref": "#/$defs/inlineContainer" },
        "heading": {
          "type": "object",
          "required": ["level", "label", "content"],
          "properties": {
            "level": { "type": "integer", "minimum": 1, "maximum": 4 },
            "label": { "$ref": "#/$defs/nullableLabel" },
            "content": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
          },
          "additionalProperties": false
        },
        "code": {
          "type": "object",
          "required": ["language", "source"],
          "properties": {
            "language": { "type": ["string", "null"] },
            "source": { "type": "string" }
          },
          "additionalProperties": false
        },
        "orderedList": {
          "type": "object",
          "required": ["start", "items"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "items": { "type": "array", "items": { "$ref": "#/$defs/listItem" } }
          },
          "additionalProperties": false
        },
        "unorderedList": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": { "type": "array", "items": { "$ref": "#/$defs/listItem" } }
          },
          "additionalProperties": false
        },
        "quote": {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": { "type": "array", "items": { "$ref": "#/$defs/block" } }
          },
          "additionalProperties": false
        },
        "displayMath": {
          "type": "object",
          "required": ["latex"],
          "properties": { "latex": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "listItem": {
      "type": "object",
      "required": ["ordinal", "content"],
      "properties": {
        "ordinal": { "type": ["integer", "null"], "minimum": 0 },
        "content": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    },
    "textValue": {
      "type": "object",
      "required": ["source", "blocks"],
      "properties": {
        "source": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    },
    "theoremValue": {
      "type": "object",
      "required": ["name", "label", "proof", "sorryAx"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/nullableLabel" },
        "proof": { "type": "string", "minLength": 1 },
        "sorryAx": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "referenceValue": {
      "type": "object",
      "required": ["name", "info"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "info": { "$ref": "#/$defs/theoremInfo" }
      },
      "additionalProperties": false
    },
    "componentData": {
      "oneOf": [
        { "type": "object", "required": ["text"], "properties": { "text": { "type": "object", "required": ["value"], "properties": { "value": { "$ref": "#/$defs/textValue" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["theorem"], "properties": { "theorem": { "type": "object", "required": ["value"], "properties": { "value": { "$ref": "#/$defs/theoremValue" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["latex"], "properties": { "latex": { "type": "object", "required": ["value"], "properties": { "value": { "$ref": "#/$defs/latexComponent" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["figure"], "properties": { "figure": { "type": "object", "required": ["value"], "properties": { "value": { "$ref": "#/$defs/figureComponent" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["references"], "properties": { "references": { "type": "object", "required": ["value"], "properties": { "value": { "type": "array", "items": { "$ref": "#/$defs/referenceValue" } } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["custom"], "properties": { "custom": { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "type": "string" }, "value": true }, "additionalProperties": false } }, "additionalProperties": false }
      ]
    },
    "component": {
      "type": "object",
      "required": ["source", "data"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceLocation" },
        "data": { "$ref": "#/$defs/componentData" }
      },
      "additionalProperties": false
    }
  }
}
