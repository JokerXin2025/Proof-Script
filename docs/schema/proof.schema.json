{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-script.local/schema/proof-tree-0.3.0.json",
  "title": "Proof-Script Proof Tree JSON",
  "description": "Version 0.3.0 proof-tree envelope with a lossless expression DAG and external resources.",
  "type": "object",
  "required": ["schemaVersion", "code"],
  "properties": {
    "schemaVersion": { "const": "0.3.0" },
    "code": { "type": "string" },
    "expressions": {
      "description": "The recorded expression DAG. Absent for code-only := by declarations.",
      "type": "object",
      "propertyNames": { "pattern": "^e[0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/expressionNode" }
    },
    "proof": {
      "description": "The recorded proof steps. Absent for code-only := by declarations.",
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "oneOf": [
    { "required": ["expressions", "proof"] },
    {
      "not": {
        "anyOf": [
          { "required": ["expressions"] },
          { "required": ["proof"] }
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["title", "label", "extra"],
      "properties": {
        "title": { "type": "string" },
        "label": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
            { "type": "null" }
          ]
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "expressionRef": {
      "type": "object",
      "required": ["$ref"],
      "properties": { "$ref": { "type": "string", "pattern": "^e[0-9]+$" } },
      "additionalProperties": false
    },
    "resourceRef": {
      "type": "object",
      "required": ["$resource"],
      "properties": {
        "$resource": {
          "type": "object",
          "required": ["path", "hash", "mediaType", "encoding"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "hash": { "type": "string", "minLength": 1 },
            "mediaType": { "type": "string", "minLength": 1 },
            "encoding": { "const": "utf-8" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "expressionNode": {
      "description": "A complete serialized Lean expression node. Recursive expression fields contain expressionRef objects.",
      "type": "object",
      "required": ["kind", "isProp"],
      "properties": {
        "kind": { "enum": ["bvar", "fvar", "mvar", "sort", "const", "app", "lam", "forall", "let", "lit", "mdata", "proj"] },
        "isProp": { "type": "boolean" },
        "typeOf": { "$ref": "#/$defs/expressionRef" },
        "fn": { "$ref": "#/$defs/expressionRef" },
        "arg": { "$ref": "#/$defs/expressionRef" },
        "type": { "$ref": "#/$defs/expressionRef" },
        "body": { "$ref": "#/$defs/expressionRef" },
        "value": { "$ref": "#/$defs/expressionRef" },
        "expr": { "$ref": "#/$defs/expressionRef" },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expr", "binderInfo", "isExplicit", "isTypeclass"],
            "properties": {
              "expr": { "$ref": "#/$defs/expressionRef" },
              "binderInfo": { "type": ["string", "null"] },
              "isExplicit": { "type": ["boolean", "null"] },
              "isTypeclass": { "type": ["boolean", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "expression": {
      "description": "An expression reference or tactic-specific JSON value.",
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "goalRecord": {
      "type": "object",
      "required": ["_goal_"],
      "properties": {
        "_goal_": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": true
    },
    "stepRecord": {
      "type": "object",
      "required": ["_step_"],
      "properties": {
        "_step_": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/metadata" },
        "language": { "type": "string" },
        "source": { "type": "string" },
        "svg": { "$ref": "#/$defs/resourceRef" },
        "proof": {
          "anyOf": [
            { "$ref": "#/$defs/resourceRef" },
            { "$ref": "#/$defs/expression" }
          ]
        }
      },
      "additionalProperties": true
    },
    "strategyRecord": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "info": { "$ref": "#/$defs/expression" }
      },
      "additionalProperties": true
    },
    "record": {
      "oneOf": [
        { "$ref": "#/$defs/goalRecord" },
        { "$ref": "#/$defs/stepRecord" },
        { "$ref": "#/$defs/strategyRecord" }
      ]
    }
  }
}
